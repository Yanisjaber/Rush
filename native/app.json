{
  "expo": {
    "name": "Rush",
    "slug": "rush",
    "version": "0.1.0",
    "scheme": "rush",
    "orientation": "portrait",
    "icon": "./assets/icone/icone-rush-1024.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "TODO.rush",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "TODO.rush",
      "allowBackup": false
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
