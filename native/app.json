{
  "expo": {
    "name": "Rush",
    "slug": "rush",
    "version": "0.1.0",
    "scheme": "rush",
    "orientation": "portrait",
    "icon": "./assets/icone/icone-rush-1024.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.yanisjaber.rush",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.yanisjaber.rush",
      "allowBackup": false
    },
    "plugins": ["expo-router", "./plugins/withExpoGlAndroidR8", ["expo-splash-screen", { "backgroundColor": "#f5f4f0", "dark": { "backgroundColor": "#0c0d10" } }], ["expo-image-picker", { "photosPermission": "Rush utilise ta photo pour ton profil." }]],
    "experiments": {
      "typedRoutes": true
    }
  }
}
